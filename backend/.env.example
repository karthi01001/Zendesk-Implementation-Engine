# Optional: credentials for the `zie` CLI (auth test, snapshot). The web UI does not use this
# file; it stores credentials in Windows Credential Manager when you click Connect.
# Copy to backend/.env and fill in. Never commit .env.

ZIE_SUBDOMAIN=pdi-nagarro6612
ZIE_CLIENT_ID=
ZIE_CLIENT_SECRET=
# read = explore only. "read write" is needed only for Plan & apply (Phase 4).
ZIE_SCOPE=read

# Server settings
# ZIE_HOST=127.0.0.1
# ZIE_PORT=8000
